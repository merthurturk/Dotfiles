#!/usr/bin/env bash
#
# dot -- one entry point for everything this setup can do.
#
#   dot <group> <verb> [args]     e.g. dot scene open chill
#   dot <command> [args]          e.g. dot doctor
#   dot capabilities [--json]     machine-readable list of everything below
#   dot help
#
# Each capability is a script in libexec/dot/ named <group>-<verb>. Every one
# of them answers --describe with a JSON descriptor, which is what makes this
# surface discoverable: the launcher renders from it, and so can an agent.
# Nothing has to be registered in a second place.

set -u

# Resolve through symlinks: dot is normally invoked via ~/.local/bin/dot, and
# dirname on the link would put DOT_ROOT in the wrong place entirely.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  target="$(readlink "$SELF")"
  case "$target" in
    /*) SELF="$target" ;;
     *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$target" ;;
  esac
done
DOT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
export DOT_ROOT
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
LIBEXEC="$DOT_ROOT/libexec/dot"

# Where capabilities live. Earlier entries win, so dropping your own
# `window-split` into ~/.config/dot/libexec overrides the shipped one without
# touching this repo -- and a capability of your own survives `git pull` and
# `git clean` instead of sitting in the tree for ever.
#
# A package is just a directory on this path. Nothing else is needed: the
# descriptor already carries everything the launcher, `dot help` and the
# validator read.
DOT_PATH="${DOT_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/dot/libexec:$LIBEXEC}"
export DOT_PATH

# So a capability outside this repo can still `source "${DOT_LIB:?}"`. The
# documented preamble used to be relative to the capability, which meant the
# library that makes capabilities cheap to write was reachable only from inside
# the one directory.
DOT_LIB="$LIBEXEC/_lib.sh"
export DOT_LIB

die() { printf 'dot: %s\n' "$*" >&2; exit 1; }

# "<name>\t<path>" for every capability on DOT_PATH, first match winning.
# Files starting with _ are shared code, not commands.
list_paths() {
  local dir f b
  local IFS=:
  for dir in $DOT_PATH; do
    [ -d "$dir" ] || continue
    for f in "$dir"/*; do
      [ -f "$f" ] && [ -x "$f" ] || continue
      b="${f##*/}"
      case "$b" in _*) continue ;; esac
      printf '%s\t%s\n' "$b" "$f"
    done
  done | sort -t"$(printf '\t')" -k1,1 -u
}

list_commands() { list_paths | cut -f1; }

# The file that would run for a given name, honouring the path order.
resolve() {   # <name>
  list_paths | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }'
}

usage() {
  cat <<EOF
usage: dot <group> <verb> [args]
       dot <command> [args]

commands:
EOF
  local last=""
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    local group="${c%%-*}" verb="${c#*-}"
    [ "$verb" = "$c" ] && verb=""
    local summary
    summary="$("$LIBEXEC/$c" --describe 2>/dev/null | jq -r '.summary // ""' 2>/dev/null)"
    if [ "$group" != "$last" ]; then printf '\n'; last="$group"; fi
    printf '  %-26s %s\n' "dot ${group}${verb:+ $verb}" "$summary"
  done < <(list_commands)
  printf '\n  %-26s %s\n' "dot capabilities --json" "everything above, machine-readable"
}

# --- capability discovery -------------------------------------------------

capabilities() {
  # Descriptors are computed live -- instances track open scenes, occupied
  # workspaces and so on -- so this can't be cached. It is on the latency path
  # for every ⌥space, so it runs the probes concurrently and assembles once.
  # Serially, with a jq to validate and another to append per capability, this
  # took 520ms; the appends also re-serialised a growing array each time.
  # Two things here are deliberate and measured, on an 8-core machine where 31
  # descriptors take about four waves:
  #
  #   `bash "$LIBEXEC/$c"` rather than executing the file. Exec'ing a script
  #   costs ~15ms more than handing the same file to bash -- the kernel
  #   validates an executable, bash just reads a file -- and that is paid once
  #   per capability. Worth ~30ms of the total. The shebangs stay, because
  #   every one of these is also a command you can run yourself.
  #
  #   No jq per capability. Adding `command` used to fork one for each, 31
  #   processes to add one key; `input_filename` lets the single assembling jq
  #   do it from the file name it is already reading.
  local tmp c
  tmp="$(mktemp -d)"

  # One watchdog for the batch, not one per descriptor. Without any, a single
  # slow --describe hangs ⌥space for ever with no window and no error --
  # survivable while every capability is ours, unacceptable once DOT_PATH can
  # load someone else's. Per-descriptor watchdogs cost two extra processes each
  # and measured 40ms on the open; this costs two in total.
  local pids=""
  while IFS=$'\t' read -r c path; do
    [ -n "$c" ] || continue
    bash "$path" --describe > "$tmp/$c" 2>/dev/null &
    pids="$pids $!"
  done < <(list_paths)

  # shellcheck disable=SC2086  # the list is pids we just collected
  { sleep 3; kill -9 $pids 2>/dev/null; } &
  local watchdog=$!
  # shellcheck disable=SC2086
  wait $pids 2>/dev/null

  # Take down the sleep as well as the subshell around it, with SIGKILL.
  #
  # This line used to be `kill "$watchdog"`, and it cost every ⌥space the whole
  # three seconds. Bash does not act on a TERM in a subshell while it is
  # waiting on a foreground child, so the signal sat queued behind `sleep 3`
  # and `wait` below blocked until the sleep finished on its own -- turning the
  # deadline the watchdog exists to impose into the time it always took. The
  # palette had been measured at 165ms; it was 3.2 seconds.
  #
  # The child's pid has to be read before the parent dies, or it is reparented
  # and pgrep -P finds nothing.
  local sleeper; sleeper="$(pgrep -P "$watchdog" 2>/dev/null)"
  # shellcheck disable=SC2086  # unquoted: empty means "no child to kill"
  kill -9 "$watchdog" ${sleeper:-} 2>/dev/null
  wait "$watchdog" 2>/dev/null

  # Filenames sort the same way list_commands does, so order is unchanged.
  # `// empty` drops anything that failed to produce valid JSON rather than
  # failing the whole surface; check-capabilities.sh is what catches that.
  jq -n '[ inputs
           | . + {command: ("dot " + (input_filename | split("/")[-1] | sub("-"; " ")))} ]' \
     "$tmp"/* 2>/dev/null || echo '[]'
  rm -rf "$tmp"
}

# --- dispatch -------------------------------------------------------------

case "${1:-}" in
  ""|help|-h|--help) usage; exit 0 ;;
  capabilities)
    shift
    if [ "${1:-}" = "--paths" ]; then list_paths; exit 0; fi
    if [ "${1:-}" = "--json" ] || [ $# -eq 0 ]; then
      capabilities
    else
      die "usage: dot capabilities [--json]"
    fi
    exit 0
    ;;
esac

# Try "<group>-<verb>" first, then a bare "<command>" -- both through the path,
# so an override earlier in DOT_PATH wins.
if [ $# -ge 2 ] && cmd="$(resolve "$1-$2")" && [ -n "$cmd" ]; then
  shift 2
elif cmd="$(resolve "${1:-}")" && [ -n "$cmd" ]; then
  shift
else
  printf 'dot: unknown command: %s\n\n' "$*" >&2
  usage >&2
  exit 1
fi

exec "$cmd" "$@"
