# Theme — Catppuccin Latte, the same palette as the sketchybar config:
# its background (#eff1f5) and foreground (#4c4f69) match colors.sh exactly.
theme = Catppuccin Latte

# Draw the titlebar in the terminal's own colours rather than following the
# system appearance, so the whole window reads as one light surface.
window-theme = ghostty

# Accent tie-in: blue is the focused workspace pill in the bar and the
# selected row in the picker. Latte's own cursor is rosewater, which reads as
# unrelated next to the bar.
cursor-color = #1e66f5

# Divider matches the bar's border colour.
split-divider-color = #bcc0cc
unfocused-split-opacity = 0.92

# Font
# Each Berkeley Mono weight installs as a separate family, so bold and italic
# have to be named explicitly -- otherwise Ghostty synthesises them.
font-family = Berkeley Mono
font-family-bold = Berkeley Mono Bold SemiCondensed
font-family-italic = Berkeley Mono SemiCondensed Oblique
font-family-bold-italic = Berkeley Mono Bold SemiCondensed Oblique
font-size = 13

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = tabs

# Cursor
cursor-style = bar
cursor-style-blink = false

# Quality of life
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
mouse-hide-while-typing = true

# Naming
shell-integration-features = no-title

# Theme, managed by `dot theme set`. Must be last: later keys win.
config-file = theme.conf
