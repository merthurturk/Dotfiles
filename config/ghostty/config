# No colours in this file. Every one of them -- palette, background, cursor,
# split divider -- lives in theme.conf, which is a symlink into the active
# theme. A colour here would silently outlive a theme change, and the terminal
# would be the one surface still wearing the old palette.

# Draw the titlebar in the terminal's own colours rather than following the
# system appearance, so the whole window reads as one surface.
window-theme = ghostty

unfocused-split-opacity = 0.92

# No reload keybind is needed here. Ghostty has no IPC, but `dot theme set`
# repaints open panes with OSC escape sequences written straight to their
# ttys -- see libexec/dot/theme-set. New windows read this config anyway.

# Font
# Each Berkeley Mono weight installs as a separate family, so bold and italic
# have to be named explicitly -- otherwise Ghostty synthesises them.
font-family = Berkeley Mono
font-family-bold = Berkeley Mono Bold SemiCondensed
font-family-italic = Berkeley Mono SemiCondensed Oblique
font-family-bold-italic = Berkeley Mono Bold SemiCondensed Oblique
font-size = 13

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = tabs

# Cursor
cursor-style = bar
cursor-style-blink = false

# Quality of life
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
mouse-hide-while-typing = true

# Naming
shell-integration-features = no-title

# Theme, managed by `dot theme set`. Must be last: later keys win.
config-file = theme.conf
