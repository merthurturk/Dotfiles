#!/usr/bin/env bash
#
# SketchyBar configuration for AeroSpace — the active theme in themes/.
#
# Workspace pills are plain items (not mission-control `space` items) because
# AeroSpace manages its own workspaces on a single macOS space. They are
# refreshed as a batch by plugins/aerospace.sh, driven by the
# `aerospace_workspace_change` event that the event bridge triggers.

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export CONFIG_DIR="$HOME/.config/sketchybar"

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# Drop the font cache so a reload re-probes; plugins then read the fresh value
# rather than paying ~70ms for an AppKit query on every repaint.
rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/aerospace/fonts"
source "$CONFIG_DIR/fonts.sh"

##### Geometry #####
# macOS 26 draws window corners as squircles, not circles -- fitting the arc of
# a native window on this display gives a superellipse of n≈4.5, which reads as
# a ~16pt circular radius. sketchybar draws circular corners only, so 16 is the
# value that visually matches.
BAR_HEIGHT=36
BAR_RADIUS=16

# Concentric rounding: a nested radius is the outer radius minus the gap
# between the two edges. That keeps inner and outer curves parallel instead of
# drifting apart, which is what makes nested rounded rectangles look right.
PILL_HEIGHT=26
PILL_INSET=$(( (BAR_HEIGHT - PILL_HEIGHT) / 2 ))
PILL_RADIUS=$(( BAR_RADIUS - PILL_INSET ))

# The inset has to be uniform for the concentric rule to hold -- if a chip sits
# 5pt from the top but 12pt from the side, its corner curve is no longer
# parallel to the bar's and the nesting looks off. A chip's distance from the
# bar edge is bar padding + item padding, so the bar's own padding is whatever
# is left over after the per-item padding that spaces chips from each other.
ITEM_PADDING=4
BAR_PADDING=$(( PILL_INSET - ITEM_PADDING ))

##### Bar #####
# Whether the bar is a surface at all is theme data -- BAR_COLOR and
# BAR_BORDER_COLOR. The current theme sets both transparent, so the geometry
# below still reserves the space but nothing is drawn: the chips float over the
# wallpaper on their own. A theme that wants a bar-shaped surface back just
# gives those two a colour.
#
# The width stays at 1 either way. A transparent border still reserves its
# pixel, so switching between the two doesn't move anything.
#
# Whatever it draws, it draws no shadow -- this setup outlines (see
# config/borders/bordersrc), and blur was causing recomposition flicker.

sketchybar --bar height=$BAR_HEIGHT \
                 position=top \
                 sticky=on \
                 padding_left=$BAR_PADDING \
                 padding_right=$BAR_PADDING \
                 margin=8 \
                 y_offset=6 \
                 corner_radius=$BAR_RADIUS \
                 color="$BAR_COLOR" \
                 border_width=1 \
                 border_color="$BAR_BORDER_COLOR" \
                 shadow=off

##### Defaults #####

default=(
  padding_left="$ITEM_PADDING"
  padding_right="$ITEM_PADDING"
  icon.font="$ICON_FONT:Bold:15.0"
  label.font="$FONT_MEDIUM:13.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  icon.padding_left=6
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=6
  background.corner_radius="$PILL_RADIUS"
  background.height="$PILL_HEIGHT"
  background.border_width=1
  background.border_color="$TRANSPARENT"
)
sketchybar --default "${default[@]}"

##### Items #####
#
# Every item is a file. sketchybarrc keeps the bar, the defaults and the
# geometry; what is *in* the bar is a directory, so adding a widget no longer
# means editing this file -- and a widget of your own survives `git pull`.
#
# Earlier directories win by filename, the same rule DOT_PATH uses for
# capabilities. This was the last hand-maintained registry in the repo.

SKETCHY_ITEM_PATH="${SKETCHY_ITEM_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/dot/sketchybar/items:$CONFIG_DIR/items}"

# Brackets group items that are defined in different files, so they are
# collected as the items declare themselves and materialised once at the end.
BRACKET_status=""

# Sorted by filename across every directory, not directory by directory: a
# user file named 55- has to run between the shipped 50- and 60- if it wants to
# append to a bracket one of them declares. Directory order still decides which
# file wins when two share a name, so shadowing works and ordering works.
_seen=""
while IFS= read -r _entry; do
  _b="${_entry%%	*}"
  _f="${_entry#*	}"
  case " $_seen " in *" $_b "*) continue ;; esac
  _seen="$_seen $_b"
  # shellcheck source=/dev/null
  source "$_f"
done < <(
  for _dir in ${SKETCHY_ITEM_PATH//:/ }; do
    [ -d "$_dir" ] || continue
    for _f in "$_dir"/*.sh; do
      [ -f "$_f" ] && printf '%s\t%s\n' "${_f##*/}" "$_f"
    done
  done | sort -t"$(printf '\t')" -k1,1 -s
)

# shellcheck disable=SC2086  # a list of item names, by construction
[ -n "$BRACKET_status" ] && sketchybar --add bracket status $BRACKET_status \
  --set status background.color="$GROUP_BG" \
               background.border_color="$GROUP_BORDER" \
               background.border_width=1 \
               background.corner_radius=$PILL_RADIUS \
               background.height="$PILL_HEIGHT"

##### Initial paint #####

sketchybar --update
"$PLUGIN_DIR/aerospace.sh"
