<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.dotfiles.theme-auto</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/dot</string>
        <string>theme</string>
        <string>auto</string>
        <string>--watch</string>
    </array>

    <!-- Resident, not periodic. --watch sleeps until the next transition and
         applies it on the second, rather than polling every ten minutes and
         landing up to ten minutes late. It caps each sleep at half an hour so
         a lid closed through dusk self-corrects: sleep does not run while the
         machine is asleep. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- The loop should not end; if it does, something went wrong and the
         right answer is to start it again rather than silently stop following
         the sun. ThrottleInterval stops a tight loop if it fails instantly. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/aerospace/theme-auto.err</string>
</dict>
</plist>
