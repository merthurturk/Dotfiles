#!/usr/bin/env bash
#
# dot ai [--plan] [--yes] [request]
#
# Default: opens a real Claude Code session in a Ghostty window beside the
# focused one, in this repo, with your request as the opening message. That
# session has the whole toolkit -- it can read the configs, run `dot`, check
# what actually happened and iterate -- which a one-shot planner cannot.
#
# --plan: the constrained path instead. Claude gets only the capability
# manifest, may emit only `dot` commands, and the plan is confirmed before
# anything runs. Useful when you want a deterministic action, not a
# conversation.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
# shellcheck source=/dev/null
source "$DOT_ROOT/config/aerospace/split-lib.sh"

GHOSTTY=/Applications/Ghostty.app/Contents/MacOS/ghostty
PICKER="$DOT_ROOT/config/aerospace/bin/picker"

if [ "${1:-}" = "--describe" ]; then
  jq -n '{
    id: "ai",
    summary: "Ask Claude to change or explain something",
    args: [{name:"--plan", required:false}, {name:"--yes", required:false},
           {name:"request", required:false}],
    destructive: false,
    guard: "a session runs with your normal Claude Code permissions; --plan is restricted to dot commands and confirmed first",
    instances: [
      {label: "Ask Claude…", detail: "opens a session beside this window", args: []},
      {label: "Ask Claude for a plan…", detail: "dot commands only, confirmed", args: ["--plan"]}
    ]
  }'
  exit 0
fi

command -v claude >/dev/null 2>&1 || { echo "dot ai: claude CLI not found" >&2; exit 1; }

PLAN_MODE=0; ASSUME_YES=0
while [ $# -gt 0 ]; do
  case "$1" in
    --plan) PLAN_MODE=1; shift ;;
    --yes)  ASSUME_YES=1; shift ;;
    *) break ;;
  esac
done

REQUEST="$*"
if [ -z "$REQUEST" ]; then
  REQUEST="$(PICKER_MODE=input \
             PICKER_PROMPT="$([ "$PLAN_MODE" -eq 1 ] && echo "What should I plan?" || echo "Ask Claude…")" \
             "$PICKER" </dev/null)"
fi
[ -n "$REQUEST" ] || exit 0

# --- interactive session (default) ----------------------------------------

if [ "$PLAN_MODE" -eq 0 ]; then
  [ -x "$GHOSTTY" ] || { echo "dot ai: Ghostty not found at $GHOSTTY" >&2; exit 1; }
  audit "ai session: $REQUEST"

  # Capture both *before* opening. Launching Ghostty activates it, which moves
  # focus, and AeroSpace does not necessarily place the new window on the
  # workspace you were on -- observed landing on a third workspace entirely.
  # Asking "which workspace is focused" after the fact gets the wrong answer.
  # The menu exports these from before the picker took focus; fall back to
  # asking when invoked directly from a shell.
  ORIG_WID="${DOT_ORIG_WID:-$($AEROSPACE list-windows --focused --format '%{window-id}')}"
  ORIG_WS="${DOT_ORIG_WS:-$($AEROSPACE list-workspaces --focused)}"
  BEFORE="$(snapshot_windows)"

  # printf %q so a request with quotes or spaces survives the shell.
  "$GHOSTTY" --working-directory="$DOT_ROOT" --title="dot ai" \
             -e /bin/bash -lc "claude $(printf '%q' "$REQUEST")" &

  NEW="$(wait_for_new_window "$BEFORE")"
  [ -n "$NEW" ] || { echo "dot ai: session window never appeared" >&2; exit 1; }

  # Sit it beside whatever you were looking at, so you can watch it work.
  place_window "$NEW" "$ORIG_WS"
  $AEROSPACE workspace "$ORIG_WS" 2>/dev/null
  sleep 0.4

  if [ -n "$ORIG_WID" ] && [ "$ORIG_WID" != "$NEW" ]; then
    split_resize "$ORIG_WID" 0.6 || true
  fi
  $AEROSPACE focus --window-id "$NEW" 2>/dev/null || true
  exit 0
fi

# --- constrained plan (--plan) --------------------------------------------

CAPS="$("$DOT_ROOT/bin/dot" capabilities --json)"

PROMPT="You control a macOS tiling setup through a single command, \`dot\`.

Here are every capability and its arguments, as JSON:
$CAPS

The user asks: $REQUEST

Reply with ONLY the \`dot\` commands to run, one per line, no prose, no code
fences, no explanation. Use only commands present in the manifest above. If the
request cannot be satisfied with these commands, reply with exactly: CANNOT"

PLAN="$(claude -p "$PROMPT" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' | grep -v '^```')"

if [ -z "$PLAN" ] || [ "$PLAN" = "CANNOT" ]; then
  echo "dot ai: no plan for that. Try 'dot capabilities' to see what's possible." >&2
  exit 1
fi

while IFS= read -r line; do
  [ -n "$line" ] || continue
  case "$line" in
    "dot "*) ;;
    *) echo "dot ai: refusing non-dot command: $line" >&2; exit 1 ;;
  esac
  # shellcheck disable=SC2086  # deliberate splitting to inspect the verb
  set -- $line
  if ! printf '%s' "$CAPS" | jq -e --arg c "$1 ${2:-} ${3:-}" --arg c2 "$1 ${2:-}" \
       'map(.command) | index($c) != null or index($c2) != null' >/dev/null; then
    echo "dot ai: refusing unknown command: $line" >&2; exit 1
  fi
done <<EOF
$PLAN
EOF

echo "Plan:"
printf '%s\n' "$PLAN" | sed 's/^/  /'

if [ "$ASSUME_YES" -eq 0 ]; then
  if [ -t 0 ]; then
    printf '\nRun this? [y/N] '; read -r reply
    case "$reply" in y|Y|yes) ;; *) echo "aborted"; exit 0 ;; esac
  else
    # Fail closed: only an explicit "Run" proceeds.
    answer="$(printf 'Cancel\nRun\n' \
      | PICKER_PROMPT="Confirm" PICKER_HEADER="$(printf 'Run this plan?\n\n%s' "$PLAN")" \
        "$PICKER")"
    [ "$answer" = "Run" ] || { echo "aborted"; exit 0; }
  fi
fi

while IFS= read -r line; do
  [ -n "$line" ] || continue
  audit "ai: $line"
  echo "+ $line"
  # shellcheck disable=SC2086  # validated against the manifest above
  DOT_ACTOR=ai ${line/#dot /"$DOT_ROOT/bin/dot" } || echo "  (failed)"
done <<EOF
$PLAN
EOF
