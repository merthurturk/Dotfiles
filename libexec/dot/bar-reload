#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
if [ "${1:-}" = "--describe" ]; then
  jq -n '{id:"bar.reload", summary:"Reload SketchyBar", args:[], destructive:false,
          instances:[{label:"Reload SketchyBar", detail:"", args:[]}]}'
  exit 0
fi
audit "bar reload"
exec sketchybar --reload
