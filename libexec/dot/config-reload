#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
if [ "${1:-}" = "--describe" ]; then
  jq -n '{id:"config.reload", summary:"Reload the AeroSpace config", args:[],
          destructive:false, verify:"dot doctor",
          instances:[{label:"Reload AeroSpace config", detail:"", args:[]}]}'
  exit 0
fi
audit "config reload"
exec "$AEROSPACE" reload-config
