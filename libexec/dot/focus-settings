#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
if [ "${1:-}" = "--describe" ]; then
  jq -n '{id:"focus.settings", summary:"Open macOS Focus settings",
          args:[], destructive:false,
          instances:[{label:"Focus settings", detail:"right-click the bar chip", args:[]}]}'
  exit 0
fi
open "x-apple.systempreferences:com.apple.Focus-Settings.extension" 2>/dev/null \
  || open "x-apple.systempreferences:com.apple.preference.notifications"
