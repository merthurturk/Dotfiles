#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

if [ "${1:-}" = "--describe" ]; then
  jq -n '{
    id: "focus.status",
    summary: "Report which macOS Focus is active",
    args: [{name: "--json", required: false}],
    destructive: false
  }'
  exit 0
fi

id="$(cut -f1 "$STATE_DIR/focus" 2>/dev/null)"
name="$(cut -f2 "$STATE_DIR/focus" 2>/dev/null)"
if [ "${1:-}" = "--json" ]; then
  jq -n --arg id "$id" --arg name "$name" \
     '{active: ($id != ""), mode_id: $id, mode_name: $name}'
else
  [ -n "$name" ] && echo "$name is on" || echo "Focus is off"
fi
