#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

if [ "${1:-}" = "--describe" ]; then
  name="$(cut -f2 "$STATE_DIR/focus" 2>/dev/null)"
  jq -n --arg name "$name" '
    {
      id: "focus.toggle",
      summary: "Turn macOS Focus on or off",
      args: [],
      destructive: false,
      verify: "dot focus status --json",
      note: "macOS exposes no CLI for Focus; this runs a Shortcuts shortcut",
      instances: [ if $name != "" then
          {label: "Focus: turn off", detail: ($name + " is on"), args: []}
        else
          {label: "Focus: turn on", detail: "Do Not Disturb", args: []}
        end ]
    }'
  exit 0
fi

audit "focus toggle"
CONFIG_DIR="$SKETCHY" NAME=focus BUTTON=left exec "$SKETCHY/plugins/focus_click.sh"
