#!/usr/bin/env bash
#
# The command palette. Renders whatever `dot capabilities` reports -- there is
# no list of entries here to keep in sync, which is the point: a capability that
# exists is in the menu, and one that doesn't, isn't.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
source "$DOT_ROOT/config/aerospace/logging.sh"

if [ "${1:-}" = "--describe" ]; then
  # Deliberately no instances: the menu doesn't list itself.
  jq -n '{id:"menu", summary:"Open the command palette", args:[], destructive:false}'
  exit 0
fi

PICKER="$DOT_ROOT/config/aerospace/bin/picker"
MENU="$(mktemp)"; trap 'rm -f "$MENU"' EXIT

# Capture where the user is *before* the picker takes focus. The panel closing
# and focus returning is a race, so a command that wants to act "beside what I
# was looking at" cannot ask after the fact -- it would sometimes get the wrong
# workspace, or a workspace that had moved on.
DOT_ORIG_WS="$("$AEROSPACE" list-workspaces --focused 2>/dev/null)"
DOT_ORIG_WID="$("$AEROSPACE" list-windows --focused --format '%{window-id}' 2>/dev/null)"
export DOT_ORIG_WS DOT_ORIG_WID

# A capability appears in the menu exactly when it declares instances. Query
# commands (dot scene list, dot window list) deliberately declare none -- they
# are CLI and agent surface, and printing JSON into a picker is useless.
"$DOT_ROOT/bin/dot" capabilities --json | jq -r '
  .[] | select(.id != "menu") | . as $c
  | ($c.instances // [])[]
  | [ .label,
      (.detail // ""),
      ([$c.command] + ((.args // []) | map(tostring)) | join(" "))
    ] | join("\t")' > "$MENU"

if [ "${1:-}" = "--dry-run" ]; then
  awk -F'\t' '{ printf "%-34s %-28s %s\n", $1, $2, $3 }' "$MENU"
  exit 0
fi

[ -x "$PICKER" ] || { echo "menu: picker not built - run install.sh" >&2; exit 1; }

CHOICE="$(cut -f1,2 "$MENU" \
  | PICKER_PROMPT="What do you want to do?" PICKER_CONTEXT=menu "$PICKER")"
[ -z "$CHOICE" ] && exit 0

CMD="$(awk -F'\t' -v c="$CHOICE" '$1 == c { print $3; exit }' "$MENU")"
[ -z "$CMD" ] && exit 1

# A descriptor's `command` is the human- and agent-facing string -- "dot theme
# set opal-fire" -- not a path. `dot` resolves on a shell's PATH, but the menu
# runs under AeroSpace's `exec-and-forget`, whose PATH is the [exec] table in
# aerospace.toml and does not include ~/.local/bin. Every keybinding spells out
# $HOME/.local/bin/dot for exactly this reason; this is the one place that
# built a command out of a label instead.
#
# Resolve it back to the dispatcher we were invoked through, so the menu works
# wherever it is launched from.
case "$CMD" in
  "dot "*) CMD="$DOT_ROOT/bin/dot ${CMD#dot }" ;;
esac

# Refuse to run something unresolvable, loudly. logging.sh has stderr going to
# ~/.local/state/aerospace/log, so a broken row leaves a trace instead of the
# launcher appearing to shrug -- which is how the PATH problem above went
# unnoticed for as long as it did.
# shellcheck disable=SC2086
set -- $CMD
if [ ! -x "$1" ] && ! command -v "$1" >/dev/null 2>&1; then
  echo "menu: cannot run '$1' (from row: $CHOICE)" >&2
  exit 1
fi

# shellcheck disable=SC2086  # the command and its args are built above, not user input
DOT_ACTOR=menu exec $CMD
