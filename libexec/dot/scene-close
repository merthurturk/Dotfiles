#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

if [ "${1:-}" = "--describe" ]; then
  jq -n --argjson quits "$(scenes_json | jq -c 'with_entries(.value = (.value.quit // false))')" \
        --argjson open "$("$SCENE_SH" --open-scenes 2>/dev/null \
                          | jq -R -s 'split("\n") | map(select(length>0) | split("\t"))')" '
    {
      id: "scene.close",
      summary: "Close every window on a scene'"'"'s workspace",
      args: [{name: "workspace", required: false},
             {name: "--force", required: false},
             {name: "--quit", required: false, note: "quit apps left with no windows"},
             {name: "--no-quit", required: false}],
      destructive: true,
      guard: "refuses any workspace the scene script did not open; --force overrides",
      note: "a scene with \"quit\": true also quits the apps its windows were the last of",
      verify: "dot scene list --json",
      instances: ($open | map({
        label: ("Close scene: " + .[1]),
        detail: ("workspace " + .[0] + (if $quits[.[1]] then " — and quits its apps" else "" end)),
        args: [.[0]]
      }))
    }'
  exit 0
fi

audit "scene close ${*:-}"
exec "$SCENE_SH" close "$@"
