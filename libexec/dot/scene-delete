#!/usr/bin/env bash
#
# dot scene delete <name> [--force]
#
# Removes a scene definition. It does not touch any window: if the scene is
# open, its windows stay exactly where they are and simply stop being a scene.
#
# Deliberately has no launcher row of its own -- it is reached through
# `dot scene edit`, where you have already chosen which scene you mean. A
# destructive action one keystroke from the top of a palette is how you delete
# the wrong thing.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

SHIPPED="$DOT_ROOT/config/aerospace/scenes.json"

if [ "${1:-}" = "--describe" ]; then
  jq -n --argjson choices "$(scenes_json | jq -c 'keys')" '{
    id: "scene.delete",
    summary: "Delete a scene definition, leaving its windows alone",
    args: [{name:"name", required:true, choices:$choices},
           {name:"--force", required:false}],
    destructive: true,
    guard: "confirms first, closes no windows, and never edits the shipped scenes.json",
    verify: "dot scene list --json",
    note: "reached from dot scene edit; deliberately not its own launcher row"
  }'
  exit 0
fi

NAME=""; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    -*) echo "scene delete: unknown option $1" >&2; exit 1 ;;
    *) [ -z "$NAME" ] && NAME="$1"; shift ;;
  esac
done
[ -n "$NAME" ] || { echo "usage: dot scene delete <name> [--force]" >&2; exit 1; }
scene_exists "$NAME" || { echo "scene delete: no scene '$NAME'" >&2; exit 1; }

_ledger_lib
OPEN="$(workspaces_of "$NAME")"

if [ "$FORCE" -eq 0 ]; then
  detail="the definition only; no windows are closed"
  [ -n "$OPEN" ] && detail="open on workspace $OPEN -- those windows stay, and stop being a scene"
  # Ask on the terminal, or refuse. Deliberately no picker here: the only
  # signal for "a person is at a launcher right now" would be DOT_ACTOR, and
  # that is an ordinary environment variable which every process the palette
  # launches inherits and keeps forever. A shell started from the launcher an
  # hour ago still says menu. `dot scene edit` knows it has a picker in front
  # of a person, so it does that confirmation itself and passes --force.
  if [ -t 0 ]; then
    printf 'delete scene %s? (%s) [y/N] ' "$NAME" "$detail" >&2
    read -r reply
    case "$reply" in y|Y|yes|Yes) ;; *) echo "nothing deleted" >&2; exit 0 ;; esac
  else
    printf 'scene delete: %s -- %s\n' "$NAME" "$detail" >&2
    echo "scene delete: pass --force to go ahead" >&2
    exit 1
  fi
fi

# A tombstone, not a deletion, for a scene this repo ships: dropping the key
# would only let the shipped one back in on the next merge, which reads as the
# delete having quietly failed.
json_update "$SCENES_LOCAL" --arg n "$NAME" \
  --argjson shipped "$(jq --arg n "$NAME" 'has($n)' "$SHIPPED")" \
  'if $shipped then .[$n] = null else del(.[$n]) end'

# Forget any open copy. The windows are still there and still yours; they are
# just ordinary windows now, so the pill goes back to showing app icons and
# `dot scene close` stops offering to close them as a group.
[ -n "$OPEN" ] && ledger_forget_scene "$NAME"

audit "scene delete $NAME${OPEN:+ (was open on $OPEN)}"
repaint
printf "deleted scene '%s'\n" "$NAME"
[ -n "$OPEN" ] && printf '  its windows on workspace %s are untouched\n' "$OPEN"
exit 0
