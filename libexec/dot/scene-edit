#!/usr/bin/env bash
#
# dot scene edit [name] [--rename X] [--label X] [--icon X] [--badge X] [--ratio N]
#
# Changes what a scene is called and how its pill looks. With no arguments it
# walks you through it from the launcher, which is the point: `dot scene save`
# gives every new scene the same default glyph and colour, and the moment you
# want to fix that you are looking at the bar, not a JSON file.
#
# Every change is written to scenes.local.json, including changes to the two
# scenes this repo ships -- your copy wins the merge, and a pull can still
# update the original.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

SHIPPED="$DOT_ROOT/config/aerospace/scenes.json"
ICONS="$DOT_ROOT/config/aerospace/scene-icons.tsv"
# Add your own glyphs without editing a tracked file; yours are offered first.
ICONS_LOCAL="${XDG_CONFIG_HOME:-$HOME/.config}/dot/scene-icons.tsv"
BADGES="PEACH TEAL MAUVE BLUE GREEN"

if [ "${1:-}" = "--describe" ]; then
  n="$(scenes_json | jq 'length' 2>/dev/null)"; n="${n:-0}"
  jq -n --argjson n "$n" --argjson badges "$(printf '%s\n' $BADGES | jq -R -s 'split("\n")|map(select(length>0))')" '{
    id: "scene.edit",
    summary: "Rename a scene, or change its icon, colour or split",
    args: [{name:"name", required:false, note:"asked for when omitted"},
           {name:"--rename", required:false}, {name:"--label", required:false},
           {name:"--icon", required:false}, {name:"--badge", required:false, choices:$badges},
           {name:"--ratio", required:false},
           {name:"--quit", required:false, note:"quit apps the scene leaves with no windows"},
           {name:"--no-quit", required:false}],
    destructive: false,
    guard: "writes only to scenes.local.json; the shipped scenes.json is never touched",
    verify: "dot scene list --json",
    instances: (if $n == 0 then []
                else [{label: "Edit a scene…",
                       detail: ("rename, icon, colour" + (if $n == 1 then "" else " — " + ($n|tostring) + " scenes" end)),
                       args: []}] end)
  }'
  exit 0
fi

# Writes go to the local file only. jq's * is a recursive merge, so storing one
# changed key is enough to override a shipped scene -- no need to copy the rest
# of it, which would then stop tracking upstream.
set_str()  { json_update "$SCENES_LOCAL" --arg n "$1" --arg k "$2" --arg     v "$3" \
               '.[$n] = ((.[$n] // {}) + {($k): $v})'; }
set_json() { json_update "$SCENES_LOCAL" --arg n "$1" --arg k "$2" --argjson v "$3" \
               '.[$n] = ((.[$n] // {}) + {($k): $v})'; }

NAME=""; RENAME=""; LABEL=""; ICON=""; BADGE=""; RATIO=""; QUIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --quit)   QUIT=true;  shift ;;
    --no-quit) QUIT=false; shift ;;
    --rename) RENAME="${2:-}"; shift 2 ;;
    --label)  LABEL="${2:-}";  shift 2 ;;
    --icon)   ICON="${2:-}";   shift 2 ;;
    --badge)  BADGE="${2:-}";  shift 2 ;;
    --ratio)  RATIO="${2:-}";  shift 2 ;;
    -*) echo "scene edit: unknown option $1" >&2; exit 1 ;;
    *) [ -z "$NAME" ] && NAME="$1"; shift ;;
  esac
done

DEFS="$(scenes_json)"
[ "$(printf '%s' "$DEFS" | jq 'length')" -gt 0 ] || { echo "scene edit: no scenes defined" >&2; exit 1; }

if [ -z "$NAME" ]; then
  # scene.sh --describe already emits "<name>\t<window summary>" -- the same
  # string the launcher shows against "Open scene". Deriving it again here is
  # how the two come to disagree the next time that expression is touched.
  choice="$( { _scenes_lib; scenes_summary_tsv; } 2>/dev/null \
    | while IFS=$'\t' read -r n summary; do
        printf '%s  %s\t%s\n' "$(printf '%s' "$DEFS" | jq -r --arg n "$n" '.[$n].icon // "·"')" \
               "$n" "$summary"
      done | pick "Which scene?" scene-edit-which)"
  [ -n "$choice" ] || exit 0
  NAME="${choice##*  }"
fi
printf '%s' "$DEFS" | jq -e --arg n "$NAME" 'has($n)' >/dev/null 2>&1 \
  || { echo "scene edit: no scene '$NAME'" >&2; exit 1; }

# Guided: nothing was asked for on the command line, so ask.
if [ -z "$RENAME$LABEL$ICON$BADGE$RATIO$QUIT" ]; then
  cur() { printf '%s' "$DEFS" | jq -r --arg n "$NAME" ".[\$n].$1 // \"\" | tostring"; }
  quit_now="$(printf '%s' "$DEFS" | jq -r --arg n "$NAME" 'if .[$n].quit then "yes" else "no" end')"
  field="$(printf 'Icon\t%s\nColour\t%s\nLabel\t%s\nName\t%s\nSplit\t%s\nQuit apps on close\t%s\nDelete\tremove this scene\n' \
             "$(cur icon)" "$(cur badge)" "$(cur label)" "$NAME" "$(cur ratio)" "$quit_now" \
           | pick "Change what about $NAME?" scene-edit-field | cut -f1)"
  case "$field" in
    Icon)
      g="$(cat "$ICONS_LOCAL" "$ICONS" 2>/dev/null | grep -v '^#' | awk -F'\t' 'NF==2 { print $1 "  " $2 "\t" }' \
           | pick "Pick an icon for $NAME" scene-icon | awk '{print $1}')"
      [ -n "$g" ] || exit 0
      ICON="$g" ;;
    Colour)
      # shellcheck disable=SC2086  # word splitting is the list
      c="$(for b in $BADGES; do printf '%s\t\n' "$b"; done | pick "Pick a colour for $NAME" scene-badge | cut -f1)"
      [ -n "$c" ] || exit 0
      BADGE="$c" ;;
    Label) LABEL="$(ask "What should the pill say? (now: $(cur label))")"; [ -n "$LABEL" ] || exit 0 ;;
    Name)  RENAME="$(ask "Rename $NAME to…")"; [ -n "$RENAME" ] || exit 0 ;;
    Split)
      r="$(printf '50 / 50\t0.5\n60 / 40\t0.6\n70 / 30\t0.7\n40 / 60\t0.4\n30 / 70\t0.3\n' \
           | pick "How should $NAME split?" scene-ratio | cut -f2)"
      [ -n "$r" ] || exit 0
      RATIO="$r" ;;
    "Quit apps on close")
      q="$(printf 'Yes\tquit apps this scene leaves with no windows\nNo\tjust close the windows\n' \
           | pick "Quit apps when $NAME closes?" scene-quit | cut -f1)"
      [ -n "$q" ] || exit 0
      QUIT="$([ "$q" = Yes ] && echo true || echo false)" ;;
    Delete)
      # The confirmation belongs here, where there is demonstrably a picker in
      # front of a person -- scene-delete cannot tell that from its own side.
      open_on="$(_ledger_lib; workspaces_of "$NAME")"
      d="the definition only; no windows are closed"
      [ -n "$open_on" ] && d="open on workspace $open_on -- those windows stay, and stop being a scene"
      confirm "Delete the scene $NAME?" "Delete \"$NAME\"" "$d" || exit 0
      exec "$DOT_ROOT/libexec/dot/scene-delete" "$NAME" --force ;;
    *) exit 0 ;;
  esac
fi

changed=""
[ -n "$ICON" ]  && { set_str "$NAME" icon  "$ICON";  changed="$changed icon"; }
[ -n "$LABEL" ] && { set_str "$NAME" label "$LABEL"; changed="$changed label"; }
if [ -n "$BADGE" ]; then
  BADGE="$(printf '%s' "$BADGE" | tr '[:lower:]' '[:upper:]')"
  case " $BADGES " in
    *" $BADGE "*) ;;
    *) echo "scene edit: no badge colour '$BADGE' (have:$BADGES)" >&2; exit 1 ;;
  esac
  set_str "$NAME" badge "$BADGE"; changed="$changed colour"
fi
if [ -n "$QUIT" ]; then
  set_json "$NAME" quit "$QUIT"; changed="$changed quit-on-close"
fi
if [ -n "$RATIO" ]; then
  jq -n --argjson v "$RATIO" 'if $v > 0 and $v < 1 then . else error("range") end' >/dev/null 2>&1 \
    || { echo "scene edit: ratio must be between 0 and 1" >&2; exit 1; }
  set_json "$NAME" ratio "$RATIO"; changed="$changed split"
fi

if [ -n "$RENAME" ]; then
  NEW="$(slug "$RENAME")"
  [ -n "$NEW" ] || { echo "scene edit: that is not a usable name" >&2; exit 1; }
  if [ "$NEW" != "$NAME" ]; then
    scene_exists "$NEW" && { echo "scene edit: '$NEW' already exists" >&2; exit 1; }
    # The renamed scene becomes wholly local: there is no shipped scene under
    # the new name for a partial override to merge onto.
    # A tombstone, not a deletion, when the old name is one this repo ships:
    # removing the key would let the shipped scene back in on the next merge.
    json_update "$SCENES_LOCAL" --arg old "$NAME" --arg new "$NEW" \
      --argjson obj "$(printf '%s' "$DEFS" | jq -c --arg n "$NAME" '.[$n]')" \
      --argjson shipped "$(jq --arg n "$NAME" 'has($n)' "$SHIPPED")" \
      '.[$new] = $obj | if $shipped then .[$old] = null else del(.[$old]) end'
    # An open scene is remembered by name; leaving the old one there would
    # blank its pill and make `dot scene close` stop recognising it.
    _ledger_lib; ledger_rename_scene "$NAME" "$NEW"
    changed="$changed name"
    audit "scene edit $NAME renamed to $NEW"
    NAME="$NEW"
  fi
fi

[ -n "$changed" ] || { echo "scene edit: nothing to change" >&2; exit 1; }
audit "scene edit $NAME:$changed"
repaint
printf 'scene %s:%s updated\n' "$NAME" "$changed"
scenes_json | jq -r --arg n "$NAME" '.[$n] |
  "  \(.icon // "·") \(.label // $n)   badge \(.badge // "BLUE"), split \(.ratio // 0.5)" +
  (if .quit then ", quits its apps on close" else "" end)' 
