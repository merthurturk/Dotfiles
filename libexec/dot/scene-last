#!/usr/bin/env bash
#
# dot scene last -- bounce to the scene you were in before this one.
#
# ⌥tab does this for workspaces. Scenes are the thing you actually move between,
# and they are not where AeroSpace's back-and-forth leaves you once you have
# visited an ordinary workspace in between.
#
# The order is kept in the ledger by the bar's workspace plugin, which already
# knows the focused workspace and already has the ledger in memory.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

_ledger_lib

# The most recently used scene that is not this one. The order lives in the
# ledger itself now -- see ledger-lib.sh -- so there is no separate history to
# go stale, nothing to filter against, and a scene keeps its place in the order
# when `dot scene move` takes it elsewhere.
target() { ledger_previous "$1"; }

if [ "${1:-}" = "--describe" ]; then
  cur="$(orig_ws)"
  ws="$(target "$cur")"
  name="$(scene_of "$ws")"
  jq -n --arg ws "$ws" --arg name "$name" \
        --arg kb "$(keysym "$(keybinding 'dot scene last')")" '{
    id: "scene.last",
    summary: "Go back to the scene you were in before this one",
    args: [],
    destructive: false,
    verify: "dot scene list",
    instances: (if $ws == "" then []
                else [{label: ("Back to scene: " + $name),
                       detail: (if $kb != "" then $kb else "workspace " + $ws end),
                       args: []}] end)
  }'
  exit 0
fi

CUR="$(orig_ws)"
WS="$(target "$CUR")"
[ -n "$WS" ] || { echo "scene last: no other scene is open" >&2; exit 1; }

# Land on the scene's own window, not whatever AeroSpace last focused there --
# same reason scene open asserts it.
FIRST="$(ids_of "$WS" | cut -d, -f1)"
audit "scene last -> $WS"
$AEROSPACE eval "workspace $WS${FIRST:+; focus --window-id $FIRST}" >/dev/null 2>&1 \
  || $AEROSPACE workspace "$WS"
