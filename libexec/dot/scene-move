#!/usr/bin/env bash
#
# dot scene move <workspace> [--stay] [--from <workspace>]
#
# Moves an open scene somewhere else, as a unit. Only the windows the scene
# opened travel: anything that has since landed on that workspace stays where
# it is, the same rule that keeps `dot scene close` safe.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

SCENE_SH="$DOT_ROOT/config/aerospace/scene.sh"

if [ "${1:-}" = "--describe" ]; then
  # The scene under the cursor is the one on the workspace you were looking at
  # before the palette took focus.
  ws="${DOT_ORIG_WS:-$($AEROSPACE list-workspaces --focused 2>/dev/null)}"
  name="$(awk -F'\t' -v w="$ws" '$1 == w { print $2; exit }' "$STATE_DIR/scenes" 2>/dev/null)"

  instances='[]'
  if [ -n "$name" ]; then
    # Occupied workspaces, plus the first empty one. Offering all 28 empty
    # workspaces would bury the palette in rows that are all the same row --
    # same reason `dot window send` shows one.
    instances="$(
      $AEROSPACE list-windows --monitor all --format '%{workspace}|%{app-name}' \
        | sort -u \
        | jq -R -s --arg cur "$ws" --arg name "$name" \
              --arg empty "$($AEROSPACE list-workspaces --monitor all --empty | head -1)" \
              --arg state "$(cat "$STATE_DIR/scenes" 2>/dev/null)" '
            ($state | split("\n") | map(select(length>0) | split("\t"))
                    | map({(.[0]): .[1]}) | add // {}) as $scenes
            | (if $empty == "" then [] else [{ws: $empty, apps: "empty"}] end)
              + (split("\n") | map(select(length>0) | split("|"))
                 | group_by(.[0])
                 | map({ws: .[0][0], apps: (map(.[1]) | join(", "))}))
            | map(select(.ws != $cur))
            | map({label: ("Move " + $name + " to workspace " + .ws),
                   detail: (if $scenes[.ws] then "scene: " + $scenes[.ws] else .apps end),
                   args: [.ws]})')"
  fi

  jq -n --argjson instances "$instances" '{
    id: "scene.move",
    summary: "Move an open scene to another workspace, windows and all",
    args: [{name:"workspace", required:true},
           {name:"--from", required:false, default:"the focused workspace"},
           {name:"--stay", required:false, note:"do not follow it"}],
    destructive: false,
    guard: "moves only the windows the scene opened; leaves anything else behind",
    verify: "dot scene list --json",
    undo: "dot scene move <the workspace it came from>",
    instances: $instances
  }'
  exit 0
fi

TARGET=""; FROM="${DOT_ORIG_WS:-}"; STAY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --stay) STAY="--stay"; shift ;;
    --from) FROM="${2:-}"; shift 2 ;;
    -*) echo "scene move: unknown option $1" >&2; exit 1 ;;
    *) [ -z "$TARGET" ] && TARGET="$1"; shift ;;
  esac
done
[ -n "$TARGET" ] || { echo "usage: dot scene move <workspace> [--from <workspace>] [--stay]" >&2; exit 1; }

audit "scene move -> $TARGET${FROM:+ (from $FROM)}"
# shellcheck disable=SC2086  # $STAY is a flag or empty, by construction
exec "$SCENE_SH" move $STAY "$TARGET" ${FROM:+"$FROM"}
