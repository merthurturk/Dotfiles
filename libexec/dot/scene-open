#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

if [ "${1:-}" = "--describe" ]; then
  jq -n \
    --argjson choices "$(jq -c 'keys' "$SCENES_JSON")" \
    --argjson instances "$(
      "$DOT_ROOT/config/aerospace/scene.sh" --describe 2>/dev/null \
      | jq -R -s --arg kb "$(keysym "$(keybinding 'dot scene open')")" '
          split("\n") | map(select(length>0)) | map(split("\t")) |
          map({label: ("Open scene: " + .[0]),
               detail: (if .[0] == "chill" then $kb else .[1] end),
               args: [.[0]]})')" '
    {
      id: "scene.open",
      summary: "Open a named scene on the first empty workspace",
      args: [{name: "scene", required: true, choices: $choices}],
      destructive: false,
      verify: "dot scene list --json",
      undo: "dot scene close <workspace>",
      instances: $instances
    }'
  exit 0
fi

audit "scene open ${*:-}"
exec "$DOT_ROOT/config/aerospace/scene.sh" "$@"
