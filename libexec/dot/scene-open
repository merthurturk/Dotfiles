#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

if [ "${1:-}" = "--describe" ]; then
  jq -n \
    --argjson choices "$(scenes_json | jq -c 'keys')" \
    --argjson instances "$(
      "$SCENE_SH" --describe 2>/dev/null \
      | while IFS=$'\t' read -r name summary; do
          # Per scene, not the first `dot scene open` line in the config: that
          # one belongs to whichever scene happens to be bound, and was being
          # shown against every scene as though they all had that key.
          kb="$(keybinding "dot scene open $name")"
          printf '%s\t%s\n' "$name" "$([ -n "$kb" ] && keysym "$kb" || printf '%s' "$summary")"
        done \
      | jq -R -s '
          split("\n") | map(select(length>0)) | map(split("\t")) |
          map({label: ("Open scene: " + .[0]), detail: (.[1] // ""), args: [.[0]]})')" '
    {
      id: "scene.open",
      summary: "Open a named scene on the first empty workspace",
      args: [{name: "scene", required: true, choices: $choices}],
      destructive: false,
      verify: "dot scene list --json",
      undo: "dot scene close <workspace>",
      instances: $instances
    }'
  exit 0
fi

audit "scene open ${*:-}"
exec "$SCENE_SH" "$@"
