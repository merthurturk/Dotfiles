#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
if [ "${1:-}" = "--describe" ]; then
  jq -n --arg kb "$(keysym "$(keybinding 'balance-sizes')")" '{
    id:"window.balance", summary:"Reset the workspace to even splits",
    args:[], destructive:false,
    instances:[{label:"Balance window sizes", detail:$kb, args:[]}]}'
  exit 0
fi
audit "window balance"
exec "$AEROSPACE" balance-sizes
