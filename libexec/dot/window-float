#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
if [ "${1:-}" = "--describe" ]; then
  jq -n '{id:"window.float", summary:"Toggle the focused window between floating and tiling",
          args:[], destructive:false, verify:"dot window list --json",
          instances:[{label:"Toggle floating / tiling", detail:"⌥⇧; then f", args:[]}]}'
  exit 0
fi
audit "window float toggle"
exec "$AEROSPACE" layout floating tiling
