#!/usr/bin/env bash
#
# dot window reflow [--arrived <workspace>]
#
# Re-apply every open scene's declared ratio.
#
# `resize width` takes absolute points, so a split computed on one display is
# wrong on another -- move a 1710pt laptop layout to a 2560pt monitor and the
# side window ends up a sliver. `balance-sizes` fixes the overlap but throws the
# ratio away; this restores what the scene actually asked for.
#
# Only scene workspaces are touched. Their ratio is declared in scenes.json, so
# re-applying it is honouring that declaration; a workspace you sized by hand is
# left alone.
#
# Only a workspace you are looking at can be reflowed. AeroSpace gives a hidden
# one no real geometry at all -- its windows sit parked off-screen at whatever
# size they last had -- so a resize aimed at one is aimed at nothing.
#
# The rest are fixed on arrival, by `--arrived`, which the bar calls when you
# switch to a scene workspace. That used to be a queue file of workspaces this
# command could not reach; measuring is better, because the queue only knew
# about splits *this command* had given up on. A split that drifted for any
# other reason -- a window closed, a display changed while the workspace was
# hidden, an app that opened at its own size -- stayed wrong until something
# happened to queue it. And a queue entry went stale in ways the ledger did
# not: closing or moving the scene left it pointing at nothing.
#
# So there is no queue. On arrival, ask whether the split is already right and
# do nothing if it is, which is the repo's own rule about verifying against the
# world rather than keeping a note.

set -u
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
STATE_FILE="$STATE_DIR/scenes"

if [ "${1:-}" = "--describe" ]; then
  jq -n '{
    id: "window.reflow",
    summary: "Re-apply each open scene'"'"'s split for the current display",
    args: [{name: "--arrived", required: false, note: "one workspace, as you switch to it"}],
    destructive: false,
    verify: "dot window geometry",
    instances: [{label: "Reflow scene splits", detail: "after changing display", args: []}]
  }'
  exit 0
fi

# scenes-lib.sh owns the scenes.json + scenes.local.json merge, tombstones included.
# This file used to carry its own copy of it, which is how a third one comes to
# disagree with the other two.
DEFS=""
ratio_for() {
  [ -n "$DEFS" ] || DEFS="$(scenes_json)"
  printf '%s' "$DEFS" | jq -r --arg s "$1" '.[$s].ratio // 0.5'
}

# reflow_ws <workspace> -> 0 if it was resized
reflow_ws() {
  local ws="$1" name ids main
  IFS=$'\t' read -r _ name ids < <(awk -F'\t' -v w="$ws" '$1 == w { print; exit }' "$STATE_FILE" 2>/dev/null)
  [ -n "${ids:-}" ] || return 1
  main="${ids%%,*}"
  split_resize "$main" "$(ratio_for "$name")" >/dev/null 2>&1
}

[ -f "$STATE_FILE" ] || exit 0
VISIBLE="$($AEROSPACE list-workspaces --monitor all --visible 2>/dev/null)"
NL=$'\n'

visible() { case "$NL$VISIBLE$NL" in *"$NL$1$NL"*) return 0 ;; esac; return 1; }

# --arrived: called by the bar as you switch to a workspace. Cheap when there
# is nothing to do, which is almost always -- one geometry read and a
# comparison, no resize, no AeroSpace mutation.
if [ "${1:-}" = "--arrived" ]; then
  ws="${2:-}"
  [ -n "$ws" ] || { echo "usage: dot window reflow --arrived <workspace>" >&2; exit 1; }
  _ledger_lib
  name="$(scene_of "$ws")"; [ -n "$name" ] || exit 0
  visible "$ws" || exit 0

  ids="$(ids_of "$ws")"; main="${ids%%,*}"
  case "$ids" in *,*) ;; *) exit 0 ;; esac      # a lone window has no split

  # shellcheck source=/dev/null
  source "$DOT_ROOT/config/aerospace/split-lib.sh"
  expected="$(split_expected "$main" "$(ratio_for "$name")")" || exit 0
  actual="$("$DOT_ROOT/config/aerospace/bin/geometry" 2>/dev/null \
            | awk -F'\t' -v w="$main" '$1 == w { print $4; exit }')"
  [ -n "$actual" ] || exit 0

  # A point or two either way is rounding, not drift.
  off=$(( actual > expected ? actual - expected : expected - actual ))
  [ "$off" -le 2 ] && exit 0

  reflow_ws "$ws" && audit "window reflow --arrived $ws ($actual -> $expected)"
  exit 0
fi

now=0
while IFS=$'\t' read -r ws name ids; do
  [ -n "${ws:-}" ] && [ -n "${ids:-}" ] || continue
  visible "$ws" || continue
  reflow_ws "$ws" && now=$((now + 1))
done < "$STATE_FILE"

audit "window reflow ($now visible scene(s))"
[ "$now" -gt 0 ] && echo "reflowed $now scene(s); the rest are checked as you switch to them"
exit 0
